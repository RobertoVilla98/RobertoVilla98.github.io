  bibtex_show       = {true},
  title             = {Clustering analysis for indoor temperature and energy pattern identification through long-term monitoring data in a university classroom},
  author            = {Salvalai, Graziano and Villa, Roberto and Grecchi, Manuela and Bernardini, Gabriele and D'Orazio, Marco},
  abstract          = {This study addresses the management of Indoor Environmental Quality (IEQ) and energy efficiency in educational public buildings. Through a long-term monitoring campaign in a representative university classroom at Politecnico di Milano, clustering methods are applied to identify daily operational temperature and energy demand patterns, providing a robust data-driven foundation for building diagnostics and predictive management.},
  journal           = {Energy and Buildings},
  year              = {2025},
  publisher         = {Elsevier},
  doi               = {10.1016/j.enbuild.2025.116874},
  url               = {https://doi.org/10.1016/j.enbuild.2025.116874},
  html              = {https://doi.org/10.1016/j.enbuild.2025.116874},
  google_scholar_id = {u-x6o8ySG0sC},
  selected          = {true}
}

